# Copy to .env and fill in. .env is gitignored.

# Required for the /api/generate photo endpoint.
OPENAI_API_KEY=sk-...

# Optional overrides (defaults shown).
# For faces to stay faithful, prefer gpt-image-1 (supports input_fidelity)
# or gpt-image-2 over gpt-image-1-mini.
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1024x1536

# 'high' preserves faces/features from the input much more faithfully.
# Only gpt-image-1 documents support; the server retries without it if the
# model rejects it. Set to an empty string to disable.
OPENAI_IMAGE_INPUT_FIDELITY=high
