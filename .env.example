# Copy to .env and fill in. .env is gitignored.

# --- OpenAI (image redesign) ---
OPENAI_API_KEY=sk-...

# Defaults only — the admin panel overrides these at runtime.
# For faithful faces prefer gpt-image-1.5 or gpt-image-1 over gpt-image-1-mini.
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1024x1536
# 'high' preserves faces/features from the input. Empty string disables it.
OPENAI_IMAGE_INPUT_FIDELITY=high

# --- Admin panel: 2FA login (SMS + email codes) ---
# 32+ random bytes, e.g.  openssl rand -hex 32
ADMIN_SESSION_SECRET=
# Who may log in — the SMS/email codes are sent here. E.164 for the phone.
ADMIN_EMAIL=you@example.com
ADMIN_PHONE=+34600000000

# Twilio (SMS code)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_SMS_FROM=+1...

# Resend (email code). RESEND_FROM must be on a domain verified in Resend,
# e.g. "MailingLove <noreply@yourdomain.com>". For testing you can use
# "onboarding@resend.dev" (only delivers to your own Resend account email).
RESEND_API_KEY=re_...
RESEND_FROM=MailingLove <noreply@yourdomain.com>

# --- Payments (Stripe + PayPal) ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
PAYPAL_ENV=live
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
PAYPAL_WEBHOOK_ID=...
# Price per card is set in the admin (Settings -> Postcards -> Price per card).

# --- Local admin only ---
# The server uses firebase-admin. On Firebase App Hosting it auto-authenticates.
# Locally, point this at a service account JSON to enable admin + analytics:
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
