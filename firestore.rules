rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public waitlist signup — anyone can add themselves, nobody can
    // read, edit, or delete existing entries from the client.
    match /waitlist/{entryId} {
      allow create: if request.resource.data.keys().hasAll(['email', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3;
      allow read, update, delete: if false;
    }

    // config/, analytics/, adminChallenges/, users/, authChallenges/ are
    // written only by the server (Admin SDK, which bypasses these rules).
    // Clients get nothing — the catch-all below already denies them; listed
    // here to make that explicit. In particular users/ holds names and
    // mailing addresses and must never be client-readable.
    match /config/{doc} {
      allow read, write: if false;
    }
    match /analytics/{doc=**} {
      allow read, write: if false;
    }
    match /adminChallenges/{doc} {
      allow read, write: if false;
    }
    match /users/{doc} {
      allow read, write: if false;
    }
    match /authChallenges/{doc} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
